# ==============================================================================
# Local LLM Operational Center — Environment Configuration (100% Offline / Private)
# ==============================================================================

# --- Privacy & Zero Telemetry ---
DO_NOT_TRACK=1
HF_HUB_DISABLE_TELEMETRY=1
SCARF_NO_ANALYTICS=true
ANONYMIZED_TELEMETRY=false
OFFLINE_MODE=true

# --- Ollama (strictly localhost-only, Flash Attention + KV cache q8_0) ---
OLLAMA_HOST=127.0.0.1:11434
OLLAMA_ORIGINS=http://127.0.0.1:*,http://localhost:*
OLLAMA_FLASH_ATTENTION=1
OLLAMA_KV_CACHE_TYPE=q8_0
OLLAMA_KEEP_ALIVE=10m
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_NUM_PARALLEL=1
OLLAMA_NOHISTORY=1
OLLAMA_NO_CLOUD=1

# --- Heavy MoE Engine (Colibrì v2.1.0, loopback-only, anti-swap) ---
HEAVY_MOE_ENGINE=colibri
HEAVY_MOE_HOST=127.0.0.1
HEAVY_MOE_PORT=11435
HEAVY_MOE_MODEL_ID=heavy-moe-uncensored
HEAVY_MOE_RAM_GB=12
HEAVY_MOE_CTX=16384
HEAVY_MOE_MIN_FREE_RAM_GB=14
COLI_VK_TIER_RESERVE_GB=1.5
COLI_VK_TIER_HOST_GB=4
KVSAVE=0

# --- Offline Chat UI locale (zero dipendenze esterne) ---
OFFLINE_CHAT_HOST=127.0.0.1
OFFLINE_CHAT_PORT=8787

# --- Orchestrator Target Policy (opzionale, root consentite separate da ';') ---
# ORCHESTRATOR_ALLOWED_ROOTS=./workspaces

# --- LM Studio (OpenAI-compatible API locale) ---
LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1
LMSTUDIO_API_KEY=lm-studio

# --- llama.cpp server (opzionale) ---
LLAMACPP_BASE_URL=http://127.0.0.1:8080/v1

# --- Open WebUI (via services/docker-compose.yml, opzionale) ---
OPEN_WEBUI_PORT=3000

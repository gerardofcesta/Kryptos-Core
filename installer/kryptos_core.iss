; Generated by Local LLM standalone desktop packager
[Setup]
AppId={{81EE0B24-E8FB-5151-B777-2748A7474E41}}
AppName=Kryptos Core
AppVersion=3.0.0
AppPublisher=Local LLM Contributors
DefaultDirName={localappdata}\Programs\KryptosCore
DefaultGroupName=Kryptos Core
PrivilegesRequired=lowest
AppMutex=Local\KryptosCore_SingleInstance_v1
CloseApplications=force
RestartApplications=no
DisableProgramGroupPage=yes
UninstallDisplayIcon={app}\KryptosCore.exe
OutputDir=out
OutputBaseFilename=KryptosCore-Setup-3.0.0
Compression=lzma2
SolidCompression=yes
WizardStyle=modern
[Languages]
Name: "english"; MessagesFile: "compiler:Default.isl"

[Tasks]
Name: "desktopicon"; Description: "{cm:CreateDesktopIcon}"; GroupDescription: "{cm:AdditionalIcons}"; Flags: unchecked

[Dirs]
; Persistent user data lives outside {app} and is never wiped on upgrade/uninstall
Name: "{localappdata}\KryptosCore\data"; Flags: uninsneveruninstall

[Files]
Source: "..\dist\KryptosCore\*"; DestDir: "{app}"; Flags: ignoreversion recursesubdirs createallsubdirs
[Icons]
Name: "{autoprograms}\Kryptos Core"; Filename: "{app}\KryptosCore.exe"
Name: "{autodesktop}\Kryptos Core"; Filename: "{app}\KryptosCore.exe"; Tasks: desktopicon
[Run]
Filename: "{app}\KryptosCore.exe"; Description: "Launch Kryptos Core"; Flags: nowait postinstall skipifsilent
